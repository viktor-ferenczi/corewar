; BATTLE PROGRAM : MICE

; WORLD CHAMPION BATTLE PROGRAM 1985.
;   CHIP WENDELL (ROCHESTER, NEW YORK)

PTR	DAT	#0		; COPIES ITSELF TO AN OTHER POSITION
START	MOV	#12	PTR	; IN THE ARENA, SPLITS, AND IF THE
LOOP	MOV	@PTR	<5	; THE MOTHER GOT SHOT, DIES
	DJN	LOOP	PTR
	SPL	@3
	ADD	#653	2
	JMZ	-5	-6
	DAT	833
END