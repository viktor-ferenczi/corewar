START	SPL	DUPL_U
DUPL_D	MOV	#0	D_SRC
	MOV	#-7	D_DEST
	MOV	#6	D_CTR
COPY_D	MOV	<D_SRC	<D_DEST
	DJN	COPY_D	D_CTR
	JMP	$-11
D_SRC	DAT	#0
D_DEST	DAT	#0
D_CTR	DAT	#0
DUPL_U	MOV	#0	U_SRC
	MOV	#8	U_DEST
	MOV	#6	U_CTR
COPY_U	MOV	<U_SRC	<U_DEST
	DJN	COPY_U	U_CTR
	JMP	$4
U_SRC	DAT	#0
U_DEST	DAT	#0
U_CTR	DAT	#0