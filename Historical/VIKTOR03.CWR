; Viktor harmadik ”k”rk”d‚se

START	MOV	#NEXT	COUNTER
	MOV	#2	SOURCE
	MOV	#NEXT	DEST
	ADD	#3	DEST
COPY	MOV	<SOURCE	<DEST
	DJN	COPY	COUNTER
	SPL	NEXT

SEARCH	MOV	#-1000	SADDR
;SLOOP	CMP	#32	@SADDR
;	JMP	SNEXT
SLOOP	MOV	SADDR	<SADDR
	MOV	SADDR	$-13
	JMP	SLOOP
SADDR	DAT	#0

COUNTER	DAT	#0
SOURCE	DAT	#0
DEST	DAT	#0

NEXT	MOV	NEXT	NEXT+1
